# ─────────────────────────────────────────────────────────────────────────────
# Krupa Laundry — environment variables
# Copy to .env.local for local development. Never commit real values.
# NEXT_PUBLIC_* values are inlined into the browser bundle — no secrets there.
# ─────────────────────────────────────────────────────────────────────────────

# --- Site -------------------------------------------------------------------
# Canonical origin, no trailing slash. Used for metadata, sitemap and OG URLs.
NEXT_PUBLIC_SITE_URL="https://krupalaundry.in"

# Real support contact details (shown publicly across the site).
NEXT_PUBLIC_SUPPORT_PHONE="8591196243"
NEXT_PUBLIC_SUPPORT_EMAIL="care@krupalaundry.in"

# Registered entity + address, shown on the legal pages.
NEXT_PUBLIC_LEGAL_ENTITY=""
NEXT_PUBLIC_LEGAL_ADDRESS=""

# --- Database (Supabase) — REQUIRED, server-only -----------------------------
# Without these, ordering, sign-in, tracking and account all return 503.
# The service role key bypasses RLS: never expose it to the browser, never
# prefix it with NEXT_PUBLIC_. Run supabase/migrations/0001_init.sql first.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# --- Session signing — REQUIRED ----------------------------------------------
# Signs the httpOnly session cookie and keys the OTP hashes. Use 32+ random
# bytes: `openssl rand -hex 32`. Changing it signs everyone out and invalidates
# any outstanding OTP codes.
SESSION_SECRET=""

# --- SMS OTP (MSG91 OTP Widget) ------------------------------------------------
# MSG91 dashboard → OTP → Widget. The widget sends and checks the SMS in the
# browser (headless, inside our own form, with MSG91's captcha); the server then
# confirms the resulting access token with MSG91 before trusting any number.
#   MSG91_WIDGET_ID, MSG91_WIDGET_AUTH_TOKEN  sent to the browser by design
#   MSG91_AUTHKEY                             server-only — never NEXT_PUBLIC_
# Required in production. Without them, local development falls back to a
# server-generated code shown on screen; production refuses to verify.
MSG91_WIDGET_ID=""
MSG91_WIDGET_AUTH_TOKEN=""
MSG91_AUTHKEY=""

# Development only: extra hostnames allowed to load the dev server, comma-separated.
# hCaptcha refuses "localhost", so test the widget via your LAN IP, e.g. 192.168.0.102.
DEV_ALLOWED_ORIGINS=""

# --- Sign in with Google (optional) -------------------------------------------
# OAuth client from Google Cloud Console → Google Auth Platform → Clients (type:
# Web application). Authorised redirect URI: <NEXT_PUBLIC_SITE_URL>/api/auth/google/callback
# The "Continue with Google" button only appears when both are set. Needs
# supabase/migrations/0005_google_auth.sql.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Email --------------------------------------------------------------------
# Two transports; whichever is configured wins (SMTP first). With neither, email
# sign-up returns a clear 503 and order emails are logged and skipped — the order
# itself is already safe in the database.
#
# Option A — SMTP. Works with any provider and sends to ANY recipient without
# owning a domain, so it suits pre-launch. For Gmail: turn on 2-Step Verification,
# then create an app password at myaccount.google.com/apppasswords.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"                      # 587 STARTTLS, or 465 for implicit TLS
SMTP_USER="you@gmail.com"
SMTP_PASSWORD=""                     # 16-character app password, not your login
EMAIL_FROM="Krupa Laundry <you@gmail.com>"

# Option B — Resend. No dependency, better deliverability, but needs a verified
# sending domain to reach anyone other than the Resend account owner.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="orders@krupalaundry.in"

# Where new-order notifications go (the operator's inbox).
ORDER_NOTIFICATION_EMAIL=""

# --- Demo shortcuts -----------------------------------------------------------
# "true" enables the order-failure test number. Leave unset in production.
NEXT_PUBLIC_ENABLE_DEMO_MODE="false"

# --- Analytics & ads (optional; each loads only when set) --------------------
NEXT_PUBLIC_GA4_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_GOOGLE_ADS_ID=""
NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=""

# --- Error monitoring (optional) ---------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=""

# --- Not used yet -------------------------------------------------------------
# Vendors, services and service areas still come from src/data/. A geocoding key
# will be needed when real vendor coordinates replace the hard-coded ones.
# GEOCODING_API_KEY=""
